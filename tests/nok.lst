\S	"\t \n"	0
[\S]	"\t \n"	0
\D	"5"	0
\W+	"hej"	0
\d	"hej"	0
[\w]	"\"	0
[\d]	"d"	0
[^\D]	"d"	0
[abc]	"1C2"	0
[a-h]+	"ABCDEFGH"	0
[A-H]+	"abcdefgh"	0
[0-9]	"  - "	0
\s+[a-zA-Z0-9?]*	"xyz"	0
\d\d:\d\d:\d\d	"0s:00:00"	0
\d\d:\d\d:\d\d	"000:00"	0
\d\d:\d\d:\d\d	"00:0000"	0
\d\d:\d\d:\d\d	"100:0:00"	0
\d\d:\d\d:\d\d	"00:100:00"	0
\d\d:\d\d:\d\d	"0:00:100"	0
\d\d?:\d\d?:\d\d?	"a:0"	0
.?bar	"real_foo"	0
X?Y	"Z"	0
a\	"a\"	0
\	"\"	0
\w\{3\}	"ab"		0
\w\{3,\}	"ab"		0
\w\{3,4\}	"ab"		0
a^		"ba"		0
a.b		"a\nb"		0
ab\{2\}c	"abbX"		0
ab\{2\}c	"abb"		0
a\(b\)c		"ab"		0
\(a\{2\}\)a	"aa"		0
\(.*\)x	"y"		0
ab\|cd	"ac"		0
foo\|bar	"baz"		0
.\{2,3\}c	"ab"		0
[[:blank:]]	"a"		0
[[:word:]]	"_"		0
a\{2,2\}	"a"		0
a\{2\}		"{2}"		0
# Groups must be closed, and closed only once. The old forward scan only
# asked whether *some* later "\)" existed, so "\(\(a\)" compiled.
\(a		"a"		0
\(\(a\)		"a"		0
a\)		"a)"		0
# A bracket expression must be closed; "[a" used to mean "[a]".
[a		"a"		0
[]		"x"		0
# An atom that already carries a quantifier cannot take another.
a++		"aa"		0
a\{2\}\{3\}	"aaaaaa"	0
# Emacs' subject anchors: '\`' is the start of the whole subject and
# '\'' its end, so neither can hold anywhere else -- and neither is the
# literal punctuation the escaped-character default used to make of them.
\`abc	"x`abc"	0
abc\'	"abcd"	0
a\`b	"ab"	0
\`a\'	"ab"	0
\`\'	"a"	0
\(\`a\|b\)	"xa"	0
x\|\`a	"za"	0
# Shy groups: the spelling is read, so a subject spelling it out is not
# what "\(?:a\)\{2\}" wants -- it wants "aa".
\(?:a\)\{2\}	"?:a?:a"	0
\(?:a\)\{2\}	"?:a"	0
\(?:a\|b\)c	"a"	0
\(?:ab\)	"a?:b"	0
x\(?:a\|b\)y	"xcy"	0
