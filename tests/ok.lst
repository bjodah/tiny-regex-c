\d\d?:\d\d?:\d\d?		"00:00:00"	8
[Hh]ello [Ww]orld\s*[!]?	"Hello world !"	13
[Hh]ello [Ww]orld\s*[!]?	"hello world !"	13
[Hh]ello [Ww]orld\s*[!]?	"Hello World !"	13
