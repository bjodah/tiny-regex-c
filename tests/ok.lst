[Hh]ello [Ww]orld\s*[!]?	"Hello world  !"	14
[Hh]ello [Ww]orld\s*[!]?	"hello World   !"	15
.?bar			"real_bar"			4
[a-z]+\nbreak		"blahblah\nbreak"		14
[a-z\s]+\nbreak		"bla bla \nbreak"		14
[^\w][^-1-4]		")T"		2
[^\w][^-1-4]		")^"		2
[^\w][^-1-4]		"*)"		2
[^\w][^-1-4]		"!."		2
[^\w][^-1-4]		" x"		2
[^\w][^-1-4]		"$b"		2
\\			"\"		1
\x4C			"L"		1
\x4			"\\x4"		3
\x4X			"\\x4X"		4
0\|1			"0"		1
[A-Z]\|[0-9]		"0"		1
\w\|\s			"_ "		1
\w\{2\}			"ab"		2
\w\{2,\}			"abc"		3
[a-z]\{2,\}		"abcd"		4
\w\{2,3\}			"abc"		3
\w\{,2\}			"abc"		2
\w\{,3\}			"abc"		3
\w\{,4\}			"abc"		3
{2}			"{2}"		3
x{}			"x{}"		3
x{1,2,}			"x{1,2,}"	7
x{,2,}			"x{,2,}"	6
x{,}			"x{,}"		4
x{-2}			"x{-2}"		5
ab\{2\}c		"abbc"		4
\([a-z][0-9]\)+		"a0b1"		4
\([a-z][0-9]\)\{3\}		"a0b1c2"	6
\(\(ab\)\|b\)+		"abbb"	        4
# Regression: the reported match used to end past the end of the subject
# (a length was accumulated on failing backtracking paths and not undone).
a*.c+			"ac"		2
\(.*.a\{2\}\)		"baa"		3
[a-c]+\w\{2\}b		"baab"		4
\w*.\{3\}a?[a-c]\{1\}	"b11bZZZ"	4
# Regression: "\|" separates whole alternatives, not just the atom before it.
foo\|bar		"bar"		3
foo\|bar		"foo"		3
ab\|cd			"cd"		2
abc\|abd		"abd"		3
za\|b			"zb"		1
\(ab\)\|\(cd\)		"cd"		2
\(a\)\|b		"b"		1
x\(ab\|cd\)y		"xcdy"		4
\(ab\|cd\)ef		"cdef"		4
\(a\|ab\)c		"abc"		3
# Regression: groups and intervals give input back when what follows needs it.
^\(.*\),\(.*\)$		"a,b"		3
.\{2,3\}c		"abc"		3
a\{2,3\}a		"aaa"		3
a\{2,\}a		"aaa"		3
a\{,3\}a		"aaa"		3
\(.*\)x		"yx"		2
\(a*\)a		"aa"		2
\(a+\)a		"aa"		2
\(.+\)c		"bc"		2
\(a\{2\}\)a		"aaa"		3
# Emacs' intervals: a bound may be 0, the bounds may be equal, and a form
# with nothing to repeat is a literal '{'. None of these used to compile;
# they degraded to the literal characters of their own spelling.
x\{0,1\}		"x"		1
a\{0\}			"aaa"		0
a\{,0\}			"aaa"		0
a\{\}			"aaa"		0
a\{,\}			"aaa"		3
a\{0,\}			"aaa"		3
a\{2,2\}		"aaa"		2
a\{1,1\}		"aaa"		1
a\{0,3\}		"aaa"		3
\{2\}			"{2}"		3
\(\{2\}\)		"{2}"		3
\(a\)\{0\}		"aa"		0
\(ab\)\{0\}c		"abc"		1
# POSIX class names Emacs knows. "[[:blank:]]" used to match 'a', out of
# the letters spelling the class name.
[[:blank:]]		"a\tb"		1
[[:word:]]		"_a"		1
[[:ascii:]]		"a"		1
# Emacs' '?' is greedy.
a?			"a"		1
x?x			"x"		1
ab?			"ab"		2
[ab][ab]?		"baab1acc"	2
c[^a]?			"bc1cacc."	2
# A quantifier with nothing to repeat is the literal character, as in
# Emacs -- at the start of the pattern, of a group or of an alternative,
# and after an anchor. These used to be rejected outright.
*			"*"		1
+			"+"		1
?			"?"		1
^*			"*"		1
\(*\)			"*"		1
a\|*b			"*b"		2
# A ']' in the first position of a bracket expression is a member, which
# is what makes "[]" unterminated rather than an empty class.
[]a]			"a"		1
[]]			"]"		1
[^]]			"a"		1
# Emacs' subject anchors.  '\`' and '\'' assert the start and the end of
# the whole subject, which is exactly what this engine's '^' and '$'
# already assert, so they compile to the same two nodes.  They used to
# fall through to the escaped-character default and match a literal '`'
# or '\''.
\`abc			"abcd"		3
abc\'			"xabc"		3
\`abc\'			"abc"		3
\`				"`"		0
\'				"abc"		0
\`\'				""		0
\`[ \t]+			"  hi"		2
[ \t]+\'			"hi  "		2
\`.*\'			"abc"		3
\`a\{2\}\'			"aa"		2
\(\`a\|b\)			"b"		1
# A quantifier just after one of them has nothing to repeat, so it is the
# literal character, exactly as after '^'.
\`*				"*"		1
# Shy groups: "\(?:...\)" is a group that consumes no capture register.
# The '?' and ':' used to fall through as literal characters, so these
# patterns matched the text they are spelled with instead of grouping.
\(?:a\)				"a"		1
\(?:abc\)			"xabc"		3
x\(?:a\|b\)y			"xby"		3
\(?:a\|b\)c			"bc"		2
\(?:a\)*			"aaa"		3
\(?:a\)+			"aaa"		3
\(?:ab\)?c			"abc"		3
\(?:a\)\{2\}			"aaa"		2
\(?::\)				":"		1
\(?:\)				"a"		0
# The regexp-opt shape: one grouped atom, leftmost-first inside it, and
# a suffix that applies to the whole result rather than to one branch.
\(?:cart\|car\|cat\|c\)s	"cars"		4
\(?:cart\|car\|cat\|c\)s	"carts"		5
# A shy group beside a capturing one leaves its number alone.
\(?:a\)\(b\)			"ab"		2
\(?:\(a\)\)\(b\)		"ab"		2
