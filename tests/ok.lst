[^\s]+		"abc def"	3
[^fc]+		"abc def"	2
[^d\sf]+	"abc def"	3
\n		"abc\ndef"	1
b.\s*\n		"aa\r\nbb\r\ncc\r\n\r\n"	4
.*c		"abcabc"	6
.+c		"abcabc"	6
[b-z].*		"ab"		1
b[k-z]*		"ab"		1
[^0-9]		"  - "		1
[1-5-]+[-1-2]-[-]	"13132231--353444-511--"	22
\[a-z\]		"[a-z]"		5
0\|		"0"		1
0\|		""		0
0\|		"0|"		1
^0\|		"x0"		0
\d\d?:\d\d?:\d\d?		"0:0:0"		5
\d\d?:\d\d?:\d\d?		"0:00:0"	6
\d\d?:\d\d?:\d\d?		"0:0:00"	6
