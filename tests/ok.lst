[^\d]		"d"		1
[\D]		"d"		1
^.*\\.*$	"c:\Tools"	8
^[\+-]*[\d]+$	"+27"		3
[abc]		"1c2"		1
[1-5]+		"0123456789"	5
[.2]		"1C2"		1
a*$		"Xaa"		2
a*$		"Xaa"		2
